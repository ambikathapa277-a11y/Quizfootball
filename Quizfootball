
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FOOTBALL QUIZ</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #080d18;
  color: white;
  min-height: 100vh;
  padding: 20px;
}

.container {
  max-width: 650px;
  margin: 35px auto;
  background: #111a2b;
  padding: 25px;
  border-radius: 18px;
  border: 1px solid #263650;
}

h1 {
  text-align: center;
  color: #35e889;
  font-size: 30px;
}

.subtitle {
  text-align: center;
  color: #aab6c9;
}

.stats {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin: 25px 0;
}

.stat {
  background: #1c2940;
  padding: 13px;
  border-radius: 10px;
  text-align: center;
  flex: 1;
}

.stat span {
  display: block;
  color: #35e889;
  font-size: 22px;
  font-weight: bold;
  margin-top: 5px;
}

.progress-bg {
  background: #263650;
  height: 9px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 25px;
}

.progress {
  height: 100%;
  width: 0%;
  background: #35e889;
  transition: width .3s;
}

#question {
  font-size: 21px;
  line-height: 1.5;
  margin-bottom: 22px;
}

.option {
  width: 100%;
  padding: 16px;
  margin: 8px 0;
  border: 1px solid #34445f;
  background: #1b2940;
  color: white;
  border-radius: 10px;
  text-align: left;
  font-size: 16px;
  cursor: pointer;
}

.option:hover:not(:disabled) {
  border-color: #35e889;
  background: #263c50;
}

.option:disabled {
  cursor: default;
  opacity: 1;
}

.correct {
  background: #12683f !important;
  border-color: #35e889;
}

.wrong {
  background: #7b2835 !important;
  border-color: #ff6677;
}

#feedback {
  text-align: center;
  margin: 15px 0;
  font-weight: bold;
  min-height: 24px;
}

.next, .restart {
  width: 100%;
  padding: 15px;
  background: #35e889;
  color: #07130c;
  border: none;
  border-radius: 10px;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 15px;
}

.hidden {
  display: none;
}

#result {
  text-align: center;
  padding: 25px 0;
}

.final-score {
  font-size: 48px;
  color: #35e889;
  font-weight: bold;
}

@media(max-width:480px) {
  .container {
    padding: 18px;
    margin: 10px auto;
  }

  h1 {
    font-size: 25px;
  }

  #question {
    font-size: 19px;
  }
}
</style>
</head>

<body>

<div class="container">

<h1>⚽ FOOTBALL QUIZ</h1>
<p class="subtitle">Test your football knowledge!</p>

<div class="stats">
  <div class="stat">
    Question
    <span id="number">1/50</span>
  </div>
  <div class="stat">
    Score
    <span id="score">0</span>
  </div>
  <div class="stat">
    Points
    <span>+5</span>
  </div>
</div>

<div class="progress-bg">
  <div class="progress" id="progress"></div>
</div>

<div id="quiz">
  <h2 id="question"></h2>
  <div id="options"></div>
  <p id="feedback"></p>
  <button class="next hidden" id="next" onclick="nextQuestion()">
    NEXT QUESTION →
  </button>
</div>

<div id="result" class="hidden">
  <h2>🏆 QUIZ COMPLETED!</h2>
  <p>Your final score:</p>
  <div class="final-score" id="finalScore">0/250</div>
  <p id="message"></p>
  <button class="restart" onclick="restartQuiz()">
    PLAY AGAIN
  </button>
</div>

</div>

