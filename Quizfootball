let current = 0;
let score = 0;
let answered = false;

function showQuestion() {
  answered = false;
  document.getElementById("number").textContent =
    (current + 1) + "/50";

  document.getElementById("score").textContent = score;
  document.getElementById("progress").style.width =
    (current / 50 * 100) + "%";

  document.getElementById("question").textContent =
    (current + 1) + ". " + questions[current].q;

  document.getElementById("feedback").textContent = "";
  document.getElementById("next").classList.add("hidden");

  const options = document.getElementById("options");
  options.innerHTML = "";

  questions[current].o.forEach((option, index) => {
    const btn = document.createElement("button");
    btn.className = "option";
    btn.textContent = String.fromCharCode(65 + index) + ". " + option;
    btn.onclick = () => selectAnswer(index, btn);
    options.appendChild(btn);
  });
}

function selectAnswer(index, selected) {
  if (answered) return;
  answered = true;

  const correct = questions[current].a;
  const buttons = document.querySelectorAll(".option");

  buttons.forEach(btn => btn.disabled = true);

  if (index === correct) {
    score += 5;
    selected.classList.add("correct");
    document.getElementById("feedback").textContent =
      "✅ Correct! +5 Points";
  } else {
    selected.classList.add("wrong");
    buttons[correct].classList.add("correct");
    document.getElementById("feedback").textContent =
      "❌ Wrong! No points.";
  }

  document.getElementById("score").textContent = score;

  document.getElementById("next").classList.remove("hidden");
}

function nextQuestion() {
  current++;

  if (current < questions.length) {
    showQuestion();
  } else {
    finishQuiz();
  }
}

function finishQuiz() {
  document.getElementById("quiz").classList.add("hidden");
  document.getElementById("result").classList.remove("hidden");

  document.getElementById("progress").style.width = "100%";
  document.getElementById("finalScore").textContent =
    score + "/250";

  document.getElementById("message").textContent =
    score >= 200 ? "🏆 Football Expert!" :
    score >= 150 ? "🔥 Great Football Knowledge!" :
    score >= 100 ? "⚽ Good Job! Keep Learning!" :
    "Keep practicing, football fan!";
}

function restartQuiz() {
  current = 0;
  score = 0;

  document.getElementById("quiz").classList.remove("hidden");
  document.getElementById("result").classList.add("hidden");

  showQuestion();
}

showQuestion();

</script>
</body>
</html>
